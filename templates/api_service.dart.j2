import 'package:dio/dio.dart';
import 'package:path_provider/path_provider.dart';
import 'package:logging/logging.dart';
import 'dart:io';
import 'models/models.dart';
import 'models/{{ endpoint.request_model }}.dart';
import 'models/{{ endpoint.response_model }}.dart';
import 'token_manager.dart';

final _logger = Logger('ApiService');

class ApiService {
  final Dio _dio;
  final String baseUrl;
  final TokenManager _tokenManager;
  final bool _hasAuth;

  ApiService({
    required this.baseUrl,
    required TokenManager tokenManager,
    bool hasAuth = true,
  }) : _dio = Dio(BaseOptions(baseUrl: baseUrl)),
       _tokenManager = tokenManager,
       _hasAuth = hasAuth {
    _setupInterceptors();
  }

  void _setupInterceptors() {
    _dio.interceptors.add(InterceptorsWrapper(
      onRequest: (options, handler) async {
        _logger.fine('Making request to: ${options.path}');
        if (_hasAuth && _tokenManager.hasValidToken) {
          options.headers['Authorization'] = 'Bearer ${_tokenManager.accessToken}';
        }
        return handler.next(options);
      },
      onResponse: (response, handler) {
        _logger.fine('Received response from: ${response.requestOptions.path}');
        return handler.next(response);
      },
      onError: (error, handler) async {
        _logger.severe('Request error: ${error.message}');
        
        if (_hasAuth && error.response?.statusCode == 401 && _tokenManager.hasRefreshToken) {
          try {
            _logger.info('Attempting to refresh token');
            final refreshResponse = await _dio.post(
              '$baseUrl/auth/refresh',
              data: {'refresh_token': _tokenManager.refreshToken},
            );
            
            if (refreshResponse.statusCode == 200) {
              final newToken = refreshResponse.data['access_token'];
              final newRefreshToken = refreshResponse.data['refresh_token'];
              
              await _tokenManager.saveTokens(
                accessToken: newToken,
                refreshToken: newRefreshToken,
                expiryDuration: const Duration(hours: 1),
              );
              
              _logger.info('Token refreshed successfully');
              
              // Retry the original request
              final originalRequest = error.requestOptions;
              originalRequest.headers['Authorization'] = 'Bearer $newToken';
              return handler.resolve(await _dio.fetch(originalRequest));
            }
          } catch (e) {
            _logger.severe('Token refresh failed: $e');
            await _tokenManager.clearTokens();
          }
        }
        
        return handler.next(error);
      },
    ));
  }

  Future<T> _handleResponse<T>(Response response) async {
    if (response.statusCode == 200) {
      return response.data as T;
    } else {
      _logger.severe('Request failed with status: ${response.statusCode}');
      throw DioException(
        requestOptions: response.requestOptions,
        response: response,
        error: 'Request failed with status: ${response.statusCode}',
      );
    }
  }

  Future<T> _handleError<T>(dynamic error) async {
    if (error is DioException) {
      _logger.severe('Dio error: ${error.message}');
      if (error.type == DioExceptionType.connectionTimeout ||
          error.type == DioExceptionType.sendTimeout ||
          error.type == DioExceptionType.receiveTimeout) {
        throw TimeoutException('Request timed out');
      }
      if (error.type == DioExceptionType.connectionError) {
        throw ConnectionException('No internet connection');
      }
      throw ApiException(
        message: error.response?.data['message'] ?? 'Unknown error occurred',
        statusCode: error.response?.statusCode ?? 500,
      );
    }
    _logger.severe('Unknown error: $error');
    throw ApiException(message: 'Unknown error occurred', statusCode: 500);
  }

  {% for endpoint in endpoints %}
  Future<{{ endpoint.response_model }}> {{ endpoint.name }}({
    {% for param in endpoint.parameters %}
    {% if param.in == 'path' %}required {{ param.type }} {{ param.name }},{% endif %}
    {% if param.in == 'query' %}{{ param.type }}? {{ param.name }},{% endif %}
    {% endfor %}
    {% if endpoint.request_type != 'dynamic' %}required {{ endpoint.request_model }} request,{% endif %}
  }) async {
    try {
      _logger.info('Calling {{ endpoint.name }} endpoint');
      final response = await _dio.{{ endpoint.method.lower() }}(
        '{{ endpoint.path }}',
        {% if endpoint.request_type != 'dynamic' %}
        data: request.toJson(),
        {% endif %}
        queryParameters: {
          {% for param in endpoint.parameters %}
          {% if param.in == 'query' %}
          '{{ param.name }}': {{ param.name }},
          {% endif %}
          {% endfor %}
        },
      );

      return {{ endpoint.response_model }}.fromJson(response.data);
    } on DioException catch (e) {
      throw _handleError(e);
    }
  }

  {% if endpoint.has_file %}
  Future<{{ endpoint.response_model }}> {{ endpoint.name }}WithFile({
    required File file,
    {% for param in endpoint.parameters %}
    {% if param.in == 'path' %}
    required {{ endpoint.response_model }} {{ param.name }},
    {% elif param.in == 'query' %}
    {{ endpoint.response_model }}? {{ param.name }},
    {% endif %}
    {% endfor %}
    {% if endpoint.request_type != 'dynamic' %}
    {{ endpoint.request_model }}? body,
    {% endif %}
  }) async {
    try {
      _logger.info('Calling {{ endpoint.name }}WithFile endpoint');
      final formData = FormData.fromMap({
        'file': await MultipartFile.fromFile(file.path),
        {% if endpoint.request_type != 'dynamic' %}
        ...body?.toJson() ?? {},
        {% endif %}
      });

      final response = await _dio.{{ endpoint.method.lower() }}(
        '{{ endpoint.path }}',
        data: formData,
        {% if endpoint.parameters %}
        queryParameters: {
          {% for param in endpoint.parameters %}
          {% if param.in == 'query' %}
          '{{ param.name }}': {{ param.name }},
          {% endif %}
          {% endfor %}
        },
        {% endif %}
      );
      return await _handleResponse<{{ endpoint.response_model }}>(response);
    } catch (error) {
      return await _handleError<{{ endpoint.response_model }}>(error);
    }
  }

  Future<void> download{{ endpoint.name | title }}({
    required String url,
    required String fileName,
  }) async {
    try {
      _logger.info('Downloading file: $fileName');
      final response = await _dio.download(
        url,
        (await getApplicationDocumentsDirectory()).path + '/$fileName',
      );
      if (response.statusCode != 200) {
        throw ApiException(
          message: 'Download failed',
          statusCode: response.statusCode ?? 500,
        );
      }
      _logger.info('File downloaded successfully: $fileName');
    } catch (error) {
      await _handleError<void>(error);
    }
  }
  {% endif %}
  {% endfor %}
}

class ApiException implements Exception {
  final String message;
  final int statusCode;

  ApiException({required this.message, required this.statusCode});

  @override
  String toString() => 'ApiException: $message (Status: $statusCode)';
}

class ConnectionException implements Exception {
  final String message;

  ConnectionException(this.message);

  @override
  String toString() => 'ConnectionException: $message';
}

class TimeoutException implements Exception {
  final String message;

  TimeoutException(this.message);

  @override
  String toString() => 'TimeoutException: $message';
}

class RequestCancelledException implements Exception {
  @override
  String toString() => 'RequestCancelledException: Request was cancelled';
} 